---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import DemoBadge from '../components/ui/DemoBadge.astro';
import FlowLines from '../components/ui/FlowLines.astro';
import ResearchAreaCard from '../components/research/ResearchAreaCard.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import PIFeature from '../components/people/PIFeature.astro';
import PublicationItem from '../components/publications/PublicationItem.astro';
import NewsCard from '../components/news/NewsCard.astro';
import { getNews, getProjects, getPublications, getResearchAreas } from '../lib/content';
import { homeHero, site } from '../site.config';

const areas = await getResearchAreas();
const featuredAreas = areas.filter((area) => area.data.featured).slice(0, 5);
const projects = await getProjects();
const featuredProjects = (projects.filter((p) => p.data.featured).length
  ? projects.filter((p) => p.data.featured)
  : projects
).slice(0, 3);
const publications = await getPublications();
const selectedPublications = publications.filter((p) => p.data.featured).slice(0, 3);
const news = (await getNews()).slice(0, 3);
const pi = await getEntry('people', site.principalInvestigator);
---

<BaseLayout>
  <Hero size="home" media={homeHero} labelledby="hero-title">
    <div class="home-hero">
      <p class="home-hero__acronym"><span>{site.shortName}</span></p>
      <h1 id="hero-title" class="home-hero__title">{site.name}</h1>
      <p class="home-hero__affiliation">
        <span>{site.department}</span>
        <span>{site.university}</span>
      </p>
      <div class="home-hero__mission">
        <p>{site.mission.text}</p>
        {site.mission.placeholder && <DemoBadge />}
      </div>
      <div class="btn-row home-hero__actions">
        <Button href="/research/" variant="light" icon="arrow-right">Explore Our Research</Button>
        <Button href="/team/" variant="outline-light">Meet the Team</Button>
      </div>
    </div>
  </Hero>

  {
    featuredAreas.length > 0 && (
      <section class="section" aria-labelledby="research-title">
        <div class="container home-research">
          <SectionHeader
            eyebrow="Research"
            title="Research themes"
            id="research-title"
            link={{ href: '/research/', label: 'All research areas' }}
          >
            <p>
              An overview of the laboratory’s research directions. The themes shown are sample entries and will be
              replaced with CFAL’s confirmed research areas.
            </p>
          </SectionHeader>
          <div class="home-research__grid">
            {featuredAreas.map((area, index) => (
              <ResearchAreaCard area={area} index={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredProjects.length > 0 && (
      <section class="section section--surface" aria-labelledby="projects-title">
        <div class="container">
          <SectionHeader
            eyebrow="Projects"
            title="Featured projects"
            id="projects-title"
            link={{ href: '/projects/', label: 'All projects' }}
          />
          <div class="card-grid">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} areas={areas} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    pi && (
      <section class="section" aria-label="Principal Investigator">
        <div class="container">
          <PIFeature person={pi} variant="home" />
        </div>
      </section>
    )
  }

  {
    selectedPublications.length > 0 && (
      <section class="section section--surface" aria-labelledby="publications-title">
        <div class="container home-pubs">
          <SectionHeader
            eyebrow="Publications"
            title="Selected publications"
            id="publications-title"
            link={{ href: '/publications/', label: 'All publications' }}
          />
          <div class="home-pubs__list">
            {selectedPublications.map((publication) => (
              <PublicationItem publication={publication} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    news.length > 0 && (
      <section class="section" aria-labelledby="news-title">
        <div class="container">
          <SectionHeader eyebrow="News" title="Latest news" id="news-title" link={{ href: '/news/', label: 'All news' }} />
          <div class="card-grid">
            {news.map((post) => (
              <NewsCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="join-band on-dark" aria-labelledby="join-title">
    <FlowLines class="join-band__flow" lines={14} cx={0.2} cy={1.15} r={0.42} />
    <div class="container join-band__inner">
      <div class="join-band__text">
        <p class="eyebrow">Join {site.shortName}</p>
        <h2 id="join-title" class="join-band__title">Research with the lab</h2>
        <p class="join-band__lead">
          Information for prospective graduate students, undergraduate researchers and postdoctoral researchers.
          Recruiting details will be posted on the Join Us page when available.
        </p>
      </div>
      <div class="btn-row">
        <Button href="/join/" variant="light" icon="arrow-right">Opportunities</Button>
        <Button href="/contact/" variant="outline-light">Contact</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- hero ---------------- */
  .home-hero {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    max-width: 44rem;
  }

  .home-hero__acronym {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.3em;
    color: var(--color-cfal-light);
  }

  .home-hero__acronym::before {
    content: '';
    width: 2.5rem;
    height: 2px;
    background: var(--color-gold);
  }

  .home-hero__title {
    color: var(--color-on-dark);
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.005em;
  }

  .home-hero__affiliation {
    display: grid;
    gap: 0.15rem;
    padding-left: var(--space-s);
    border-left: 2px solid var(--color-cfal);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: var(--color-on-dark);
  }

  .home-hero__mission {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    max-width: 38rem;
    color: var(--color-on-dark-muted);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .home-hero__actions {
    margin-top: var(--space-2xs);
  }

  /* ---------------- research ---------------- */
  .home-research__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  @media (min-width: 40em) and (max-width: 63.99em) {
    .home-research__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------------- publications ---------------- */
  .home-pubs__list {
    border-top: 2px solid var(--color-navy);
  }

  /* ---------------- join band ---------------- */
  .join-band {
    position: relative;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-on-dark);
    padding-block: var(--space-section);
  }

  .join-band :global(.join-band__flow) {
    position: absolute;
    inset: 0;
    color: var(--color-cfal);
    opacity: 0.25;
  }

  .join-band__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
  }

  .join-band__text {
    display: grid;
    gap: var(--space-xs);
    max-width: 42rem;
  }

  .join-band__title {
    color: var(--color-on-dark);
    font-size: var(--step-4);
  }

  .join-band__lead {
    color: var(--color-on-dark-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }
</style>
