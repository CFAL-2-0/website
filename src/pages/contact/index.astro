---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import { displayName, personHref } from '../../lib/content';
import { site } from '../../site.config';

// All contact values come from `site.contact` in src/site.config.ts.
// Nothing is guessed: blank values render as visible placeholders.
const pi = await getEntry('people', site.principalInvestigator);
const { contact, links } = site;
const location = [contact.building, contact.room].filter(Boolean).join(', ');
---

<BaseLayout
  title="Contact"
  description="Contact information for the Computational Fluids and Aerodynamics Laboratory (CFAL), Department of Aerospace Engineering, Embry-Riddle Aeronautical University."
>
  <PageHeader
    eyebrow="Contact"
    title="Contact the lab"
    lead="Location and contact details for the laboratory. Prospective students should also see the Join Us page."
  />

  <section class="section" aria-label="Contact details">
    <div class="container contact-layout">
      <div class="contact-card">
        <h2 class="contact-card__title">{site.name}</h2>
        <dl class="contact-list">
          <div>
            <dt><Icon name="building" /> Department</dt>
            <dd>
              {links.department ? <ExternalLink href={links.department}>{site.department}</ExternalLink> : site.department}
            </dd>
          </div>
          <div>
            <dt><Icon name="building" /> University</dt>
            <dd><ExternalLink href={links.university}>{site.university}</ExternalLink></dd>
          </div>
          {
            pi && (
              <div>
                <dt>
                  <Icon name="user" /> Principal Investigator
                </dt>
                <dd>
                  <a href={personHref(pi)}>{displayName(pi)}</a>
                </dd>
              </div>
            )
          }
          <div>
            <dt><Icon name="mail" /> Email</dt>
            <dd>
              {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <span class="pending">Lab email to be added</span>}
            </dd>
          </div>
          {
            contact.phone && (
              <div>
                <dt>Phone</dt>
                <dd>
                  <a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>{contact.phone}</a>
                </dd>
              </div>
            )
          }
          <div>
            <dt><Icon name="map-pin" /> Lab location</dt>
            <dd>
              {location ? location : <span class="pending">Building and room to be added</span>}
              {contact.campus && <span class="contact-list__sub">{contact.campus}</span>}
            </dd>
          </div>
          <div>
            <dt><Icon name="map-pin" /> Mailing address</dt>
            <dd>
              {
                contact.addressLines.length > 0 ? (
                  <address>
                    {contact.addressLines.map((line) => (
                      <span>{line}</span>
                    ))}
                  </address>
                ) : (
                  <span class="pending">Address to be added</span>
                )
              }
            </dd>
          </div>
        </dl>
      </div>

      <div class="contact-side">
        <div class="map-panel">
          <div class="map-panel__graphic" aria-hidden="true"></div>
          <div class="map-panel__body">
            <h2 class="map-panel__title">Map &amp; directions</h2>
            {
              contact.mapUrl ? (
                <Button href={contact.mapUrl} variant="secondary" icon="map-pin" iconPosition="start">
                  Open map
                </Button>
              ) : (
                <p class="pending">Map link to be added</p>
              )
            }
          </div>
        </div>

        <div class="contact-panel">
          <h2 class="contact-panel__title">Prospective students &amp; researchers</h2>
          <p>Information about research opportunities is collected on the Join Us page.</p>
          <Button href="/join/" icon="arrow-right">Join Us</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-l);
  }

  .contact-card {
    padding: var(--space-m);
    border: var(--border-thin);
    border-top: 4px solid var(--color-navy);
  }

  .contact-card__title {
    margin-bottom: var(--space-s);
    font-size: var(--step-3);
  }

  .contact-list {
    display: grid;
    margin: 0;
  }

  .contact-list > div {
    display: grid;
    gap: 0.2rem;
    padding-block: var(--space-s);
    border-top: var(--border-thin);
  }

  .contact-list dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-list dt :global(svg) {
    color: var(--color-cfal-strong);
  }

  .contact-list dd {
    margin: 0;
  }

  .contact-list address {
    display: grid;
    font-style: normal;
  }

  .contact-list__sub {
    display: block;
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .contact-side {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .map-panel {
    border: var(--border-thin);
  }

  .map-panel__graphic {
    aspect-ratio: 16 / 7;
    background-color: var(--color-surface);
    background-image:
      radial-gradient(circle at 62% 55%, var(--color-cfal) 0 5px, transparent 6px),
      radial-gradient(circle at 62% 55%, rgb(98 165 192 / 0.25) 0 22px, transparent 23px),
      linear-gradient(rgb(4 19 61 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(4 19 61 / 0.07) 1px, transparent 1px);
    background-size:
      100% 100%,
      100% 100%,
      24px 24px,
      24px 24px;
  }

  .map-panel__body {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding: var(--space-m);
  }

  .map-panel__title,
  .contact-panel__title {
    font-size: var(--step-2);
  }

  .contact-panel {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding: var(--space-m);
    background: var(--color-surface);
    border-left: 3px solid var(--color-cfal);
  }

  @media (min-width: 60em) {
    .contact-layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl);
    }

    .contact-card {
      padding: var(--space-l);
    }
  }
</style>
