---
/**
 * Page shell used by every route: <head> metadata, skip link, header,
 * <main> landmark and footer. Page-specific interactivity is attached by the
 * components that need it, never by hydrating the whole page.
 */
import '@fontsource-variable/oswald/wght.css';
import '@fontsource-variable/roboto/wght.css';
import '../styles/global.css';
import BaseHead, { type Props as HeadProps } from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

type Props = HeadProps;

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <BaseHead {...props} />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      // Swap any image that fails to load for its styled placeholder frame.
      addEventListener(
        'error',
        function (event) {
          var el = event.target;
          if (el && el.tagName === 'IMG' && el.closest) {
            var frame = el.closest('[data-media]');
            if (frame) frame.classList.add('is-missing');
          }
        },
        true,
      );
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
