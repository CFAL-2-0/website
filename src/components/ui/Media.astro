---
/**
 * Responsive image with a fixed aspect-ratio frame and a graceful fallback.
 *
 * - Relative paths resolve to src/assets/images/ and are optimised by Astro
 *   (AVIF + WebP, srcset, explicit dimensions).
 * - "/public" paths and https URLs are used as-is.
 * - Missing/empty paths render a technical-pattern placeholder, and a runtime
 *   load error (e.g. a mistyped /public path) swaps to the same placeholder
 *   (see the error listener in BaseLayout).
 */
import { Picture } from 'astro:assets';
import { resolveImage } from '../../lib/images';

interface Props {
  src?: string | null;
  alt?: string;
  /** CSS aspect-ratio, e.g. "16 / 10", "4 / 5". Omit to use the image's own. */
  aspect?: string;
  /** `sizes` attribute describing the rendered width. */
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  position?: string;
  fallback?: 'pattern' | 'portrait';
  class?: string;
}

const {
  src,
  alt = '',
  aspect,
  sizes = '(min-width: 80em) 33vw, (min-width: 48em) 50vw, 100vw',
  widths = [480, 800, 1200, 1600],
  loading = 'lazy',
  priority = false,
  position,
  fallback = 'pattern',
  class: className,
} = Astro.props;

const resolved = await resolveImage(src);
// Never upscale: cap requested widths at the source width.
const assetWidths =
  resolved?.kind === 'asset'
    ? [...new Set(widths.map((w) => Math.min(w, resolved.image.width)))]
    : widths;
const style = [aspect && `--media-aspect: ${aspect}`, position && `--media-position: ${position}`]
  .filter(Boolean)
  .join('; ');
---

<div
  class:list={['media', `media--${fallback}`, !resolved && 'is-missing', aspect && 'media--framed', className]}
  style={style || undefined}
  data-media
>
  {
    resolved?.kind === 'asset' && (
      <Picture
        src={resolved.image}
        alt={alt}
        widths={assetWidths}
        sizes={sizes}
        formats={['avif']}
        fallbackFormat="webp"
        loading={priority ? 'eager' : loading}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        class="media__img"
        pictureAttributes={{ class: 'media__picture' }}
      />
    )
  }
  {
    resolved?.kind === 'url' && (
      <img
        src={resolved.src}
        alt={alt}
        loading={priority ? 'eager' : loading}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        class="media__img"
      />
    )
  }
  <div class="media__fallback" aria-hidden="true">
    {
      fallback === 'portrait' ? (
        <svg viewBox="0 0 80 100" class="media__silhouette">
          <circle cx="40" cy="38" r="15" />
          <path d="M12 100c0-18 12.5-30 28-30s28 12 28 30Z" />
        </svg>
      ) : (
        <span class="media__fallback-label">Image placeholder</span>
      )
    }
  </div>
</div>

<style>
  .media {
    position: relative;
    overflow: hidden;
    background-color: var(--color-navy);
    isolation: isolate;
  }

  .media--framed {
    aspect-ratio: var(--media-aspect);
  }

  .media :global(.media__picture) {
    display: contents;
  }

  .media :global(.media__img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-position, 50% 50%);
  }

  .media:not(.media--framed) :global(.media__img) {
    height: auto;
  }

  .media__fallback {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    background-color: var(--color-navy);
    background-image:
      radial-gradient(ellipse at 70% 40%, rgb(98 165 192 / 0.28), transparent 60%),
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size:
      100% 100%,
      24px 24px,
      24px 24px;
  }

  .media.is-missing {
    aspect-ratio: var(--media-aspect, 16 / 10);
  }

  .media.is-missing .media__fallback {
    display: grid;
  }

  .media.is-missing :global(.media__img) {
    display: none;
  }

  .media--portrait .media__fallback {
    background-color: var(--color-surface-strong);
    background-image:
      linear-gradient(rgb(4 19 61 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(4 19 61 / 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .media__silhouette {
    width: 58%;
    align-self: end;
    fill: var(--color-border-strong);
  }

  .media__fallback-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }
</style>
