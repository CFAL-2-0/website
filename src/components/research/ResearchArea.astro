---
/**
 * Full research-area section for the Research page:
 * title · summary · representative image · capabilities ·
 * related projects (derived from project.researchArea) ·
 * related publications (derived from publication.researchAreas).
 */
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import DemoBadge from '../ui/DemoBadge.astro';
import {
  projectHref,
  type Project,
  type Publication,
  type ResearchArea,
} from '../../lib/content';
import { STATUS_LABELS } from '../../lib/taxonomy';
import { url } from '../../lib/url';

interface Props {
  area: ResearchArea;
  index: number;
  projects: Project[];
  publications: Publication[];
}

const { area, index, projects, publications } = Astro.props;
const { title, summary, description, image, imageAlt, capabilities, placeholder } = area.data;
const headingId = `${area.id}-title`;
---

<section id={area.id} class:list={['research-area', index % 2 === 1 && 'research-area--flip']} aria-labelledby={headingId}>
  <div class="research-area__media">
    <Media
      src={image}
      alt={imageAlt}
      aspect="4 / 3"
      sizes="(min-width: 60em) 45vw, 100vw"
      widths={[480, 800, 1200]}
    />
  </div>

  <div class="research-area__body">
    <p class="research-area__index meta">{String(index + 1).padStart(2, '0')} / Research area</p>
    <h2 id={headingId} class="research-area__title">{title}</h2>
    {placeholder && <DemoBadge />}
    <p class="research-area__summary">{summary}</p>
    {description && <p class="research-area__description">{description}</p>}

    {
      capabilities.length > 0 && (
        <div class="research-area__block">
          <h3 class="research-area__subhead">Capabilities</h3>
          <ul class="capabilities">
            {capabilities.map((capability) => (
              <li>{capability}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      projects.length > 0 && (
        <div class="research-area__block">
          <h3 class="research-area__subhead">Related projects</h3>
          <ul class="related-list">
            {projects.map((project) => (
              <li>
                <a href={projectHref(project)}>{project.data.title}</a>
                <span class="meta">{STATUS_LABELS[project.data.status]}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      publications.length > 0 && (
        <div class="research-area__block">
          <h3 class="research-area__subhead">Related publications</h3>
          <ul class="related-list">
            {publications.slice(0, 3).map((publication) => (
              <li>
                <span>{publication.data.title}</span>
                <span class="meta">
                  {[publication.data.venue, publication.data.year].filter(Boolean).join(', ')}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="btn-row research-area__actions">
      {
        projects.length > 0 && (
          <a class="arrow-link" href={url(`/projects/?area=${area.id}`)}>
            Projects in this area <Icon name="arrow-right" />
          </a>
        )
      }
      {
        publications.length > 0 && (
          <a class="arrow-link" href={url(`/publications/?area=${area.id}`)}>
            Publications <Icon name="arrow-right" />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .research-area {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
    align-items: start;
    padding-block: var(--space-xl);
  }

  .research-area + :global(.research-area) {
    border-top: var(--border-thin);
  }

  .research-area__media {
    border: var(--border-thin);
  }

  .research-area__body {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
  }

  .research-area__index {
    color: var(--color-cfal-strong);
  }

  .research-area__title {
    font-size: var(--step-4);
  }

  .research-area__summary {
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .research-area__description {
    color: var(--color-muted);
  }

  .research-area__block {
    width: 100%;
    margin-top: var(--space-s);
  }

  .research-area__subhead {
    margin-bottom: var(--space-xs);
    padding-bottom: var(--space-3xs);
    border-bottom: var(--border-thin);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .capabilities {
    display: grid;
    gap: var(--space-2xs) var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    font-size: var(--step--1);
  }

  .capabilities li {
    position: relative;
    padding-left: 1.1rem;
  }

  .capabilities li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: 0.45rem;
    border: 1.5px solid var(--color-cfal-strong);
  }

  .related-list {
    display: grid;
    list-style: none;
    font-size: var(--step--1);
  }

  .related-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.1rem var(--space-s);
    padding-block: var(--space-2xs);
    border-bottom: 1px dashed var(--color-border);
  }

  .research-area__actions {
    gap: var(--space-l);
    margin-top: var(--space-s);
  }

  @media (min-width: 60em) {
    .research-area {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      padding-block: var(--space-2xl);
    }

    .research-area__media {
      position: sticky;
      top: calc(var(--header-nav-h) + var(--space-l));
    }

    .research-area--flip {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }

    .research-area--flip .research-area__media {
      order: 2;
    }
  }
</style>
