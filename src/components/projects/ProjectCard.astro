---
/**
 * Image-led project card (editorial, not dashboard). The whole card is
 * clickable through a single stretched link on the title.
 * `data-*` attributes let <FilterBar> filter cards client-side.
 */
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import DemoBadge from '../ui/DemoBadge.astro';
import { projectHref, type Project, type ResearchArea } from '../../lib/content';
import { OTHER_AREA, STATUS_LABELS } from '../../lib/taxonomy';

interface Props {
  project: Project;
  areas: ResearchArea[];
  headingLevel?: 'h2' | 'h3';
  showStatus?: boolean;
}

const { project, areas, headingLevel: Heading = 'h3', showStatus = true } = Astro.props;
const { title, summary, heroImage, heroImageAlt, status, researchArea, placeholder } = project.data;
const area = areas.find((candidate) => candidate.id === researchArea?.id);
const areaLabel = area ? (area.data.shortTitle ?? area.data.title) : OTHER_AREA.title;
---

<article
  class="project-card card-hover"
  data-filter-item
  data-area={area?.id ?? OTHER_AREA.id}
  data-status={status}
>
  <div class="project-card__media">
    <Media
      src={heroImage}
      alt={heroImageAlt}
      aspect="16 / 10"
      sizes="(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw"
      widths={[400, 640, 960, 1280]}
    />
    {
      showStatus && (
        <span class:list={['chip', 'project-card__status', status === 'current' && 'chip--current']}>
          {STATUS_LABELS[status]}
        </span>
      )
    }
  </div>
  <div class="project-card__body">
    <p class="label">{areaLabel}</p>
    <Heading class="project-card__title">
      <a class="stretched-link" href={projectHref(project)}>{title}</a>
    </Heading>
    <p class="project-card__summary">{summary}</p>
    {placeholder && <DemoBadge />}
    <span class="arrow-link project-card__more" aria-hidden="true">
      Explore project <Icon name="arrow-right" />
    </span>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-background);
    border-bottom: 2px solid var(--color-navy);
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
  }

  .project-card__media :global(.media__img) {
    transition: transform 600ms var(--ease-out);
  }

  .project-card:hover .project-card__media :global(.media__img) {
    transform: scale(1.03);
  }

  .project-card__status {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 2;
    border-color: transparent;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
    padding: var(--space-m) 0 var(--space-m);
  }

  .project-card__title {
    font-size: var(--step-2);
  }

  .project-card__title a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .project-card:hover .project-card__title a {
    color: var(--color-blue);
  }

  .project-card__summary {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .project-card__more {
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover .project-card__media :global(.media__img) {
      transform: none;
    }
  }
</style>
