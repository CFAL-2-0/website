---
/**
 * Researcher card. The name is a real <button> (inside the heading) whose
 * hit area is stretched over the whole card, so mouse, touch and keyboard
 * users all open the same profile dialog. It uses the native Invoker
 * Commands API (commandfor/command) with a small script fallback in
 * <PersonModal>. The card id makes /team/#<slug> scroll here without JS.
 */
import Media from '../ui/Media.astro';
import DemoBadge from '../ui/DemoBadge.astro';
import { displayName, personStatus, type Person } from '../../lib/content';

interface Props {
  person: Person;
  headingLevel?: 'h3' | 'h4';
}

const { person, headingLevel: Heading = 'h3' } = Astro.props;
const { portrait, researchInterests, placeholder } = person.data;
const dialogId = `person-${person.id}`;
---

<article id={person.id} class="person-card card-hover">
  <Media
    src={portrait}
    alt=""
    aspect="4 / 5"
    fallback="portrait"
    sizes="(min-width: 75em) 16rem, (min-width: 40em) 30vw, 50vw"
    widths={[240, 360, 480, 640]}
  />
  <div class="person-card__body">
    <Heading class="person-card__name">
      <button
        type="button"
        class="person-card__button stretched-link"
        commandfor={dialogId}
        command="show-modal"
        aria-haspopup="dialog"
        data-person-open={person.id}
      >
        {displayName(person)}<span class="visually-hidden">, view profile</span>
      </button>
    </Heading>
    <p class="person-card__status">{personStatus(person)}</p>
    {
      researchInterests.length > 0 && (
        <p class="person-card__interests">{researchInterests.join(' · ')}</p>
      )
    }
    {placeholder && <DemoBadge label="Placeholder" />}
  </div>
</article>

<style>
  .person-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-background);
    border: var(--border-thin);
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .person-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-m);
  }

  .person-card :global(.media) {
    border-bottom: 3px solid var(--color-navy);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .person-card:hover :global(.media) {
    border-bottom-color: var(--color-cfal);
  }

  .person-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: var(--space-s);
  }

  .person-card__name {
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .person-card__button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-navy);
    font: inherit;
    text-align: left;
  }

  .person-card:hover .person-card__button {
    color: var(--color-blue);
  }

  .person-card__status {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-cfal-strong);
  }

  .person-card__interests {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .person-card :global(.demo-badge) {
    margin-top: auto;
  }
</style>
