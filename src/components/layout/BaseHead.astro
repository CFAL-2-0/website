---
/**
 * <head> metadata: title convention, description, canonical URL, OpenGraph /
 * Twitter cards, favicons. Titles follow "Page | CFAL"; the homepage uses
 * "Computational Fluids and Aerodynamics Laboratory | ERAU".
 */
import { site } from '../../site.config';
import { url } from '../../lib/url';

export interface Props {
  title?: string;
  description?: string;
  /** /public path or absolute URL of the social image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = site.socialImage,
  imageAlt = `${site.name}, ${site.department}, ${site.university}`,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.shortName}` : `${site.name} | ${site.universityShort}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(url(image), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#04133d" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
<link rel="icon" href={url('/favicon/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={url('/favicon/apple-touch-icon.png')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={`${site.name} (${site.shortName})`} />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
